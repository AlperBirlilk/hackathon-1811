{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python manage.py:*)",
      "Bash(python manage.py:*)",
      "Bash(uv venv:*)",
      "Bash(uv pip install:*)",
      "Bash(curl -s http://127.0.0.1:8000:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(curl -s http://127.0.0.1:8080:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(**/application-local*)"
    ]
  }
}
